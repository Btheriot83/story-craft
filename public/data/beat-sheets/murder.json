{
  "id": "beats-murder-v1",
  "genre": "murder",
  "version": "1",
  "spoken_minutes_target": {
    "min": 2,
    "max": 5
  },
  "word_count_guide": {
    "min": 400,
    "max": 750,
    "ideal": 650
  },
  "ending_strength_required": "high",
  "ending_fail_modes": [
    "fade_out",
    "unsolved_shrug",
    "clue_invented_at_end",
    "confession_without_plants",
    "explanation_after_peak"
  ],
  "beats": [
    {
      "id": "murder.hook",
      "order": 1,
      "name": "Cold open / crime image",
      "act_phase": "beginning",
      "purpose": "Body, almost-body, or ominous ordinary that will become evidence; plant token for finale echo.",
      "duration_hint_sec": [
        0,
        25
      ],
      "must": [
        "arresting crime-adjacent image",
        "question (who/how/why/will they)",
        "plant fair detail"
      ],
      "avoid": [
        "suspect parade intro",
        "jargon-first autopsy",
        "warmup day-in-the-life"
      ],
      "reveal_role": "plant",
      "citations": [
        {
          "title": "Handley cold open",
          "url": "https://annhandley.com/cold-open-2/",
          "note": "Airdrop"
        },
        {
          "title": "B.K. Stevens openings notes",
          "url": "http://www.bkstevensmysteries.com/wp-content/uploads/2017/04/First2Pages-LastBlueGlass.pdf",
          "note": "Quiet then shatter / revenge intent"
        }
      ]
    },
    {
      "id": "murder.stake",
      "order": 2,
      "name": "Stake & mode contract",
      "act_phase": "beginning",
      "purpose": "Who cares + clock; signal fair-play mystery vs suspense mode.",
      "duration_hint_sec": [
        20,
        50
      ],
      "must": [
        "personal stake for POV",
        "genre contract clear",
        "cast limited"
      ],
      "avoid": [
        "stake-free puzzle toys",
        "ensemble of five equals"
      ],
      "reveal_role": "plant",
      "citations": [
        {
          "title": "Hitchcock suspense vs surprise",
          "url": "https://nofilmschool.com/alfred-hitchcock-and-francois-truffaut-explain-surprise-vs-suspense",
          "note": "Inform for suspense; twist exception"
        },
        {
          "title": "Thriller personal stake",
          "url": "https://proseengine.app/blog/how-to-write-a-thriller-suspense-twists-and-pacing",
          "note": "Personal precise stakes"
        }
      ]
    },
    {
      "id": "murder.investigation",
      "order": 3,
      "name": "Investigation / pressure",
      "act_phase": "middle",
      "purpose": "Escalate inquiry or concealment; plant dual-reading clues; one strong red herring.",
      "duration_hint_sec": [
        50,
        120
      ],
      "must": [
        "≥2 fair clues on-page",
        "one complete-feeling wrong theory",
        "forward motion every beat"
      ],
      "avoid": [
        "clue-free atmosphere only",
        "new suspect each paragraph"
      ],
      "reveal_role": "plant",
      "citations": [
        {
          "title": "Fair-play mystery",
          "url": "https://usenoren.ai/blog/how-to-write-a-fair-play-mystery",
          "note": "Clues before reveal; reclassify"
        },
        {
          "title": "Story timeline vs revelation",
          "url": "https://storyloft.app/how-to-write-a-mystery-or-thriller-plotting-red-herrings-clues-pacing/",
          "note": "Dual timelines"
        }
      ]
    },
    {
      "id": "murder.midpoint",
      "order": 4,
      "name": "False solve / midpoint flip",
      "act_phase": "middle",
      "purpose": "A theory that seems to close the case — then puncture; stakes worsen.",
      "duration_hint_sec": [
        120,
        170
      ],
      "must": [
        "false completeness",
        "puncture or deepen danger",
        "timeline remains clear"
      ],
      "avoid": [
        "midpoint that only adds vibe",
        "solution dump here"
      ],
      "reveal_role": "plant",
      "citations": [
        {
          "title": "Euchner work backwards",
          "url": "https://thestoryarchitect.substack.com/p/work-backwards-to-create-surprise",
          "note": "Complete false prior then puncture"
        },
        {
          "title": "Yorke midpoint",
          "url": "https://www.johnyorkestory.com/five-act-structure/",
          "note": "Irreversible shift"
        }
      ]
    },
    {
      "id": "murder.crisis",
      "order": 5,
      "name": "Crisis / hope crash",
      "act_phase": "middle",
      "purpose": "Hero wrong, endangered, or about to act on false theory; hope of clean solution crashes.",
      "duration_hint_sec": [
        170,
        220
      ],
      "must": [
        "personal jeopardy or moral trap",
        "listener fear of wrong outcome"
      ],
      "avoid": [
        "passive waiting for lab results",
        "rescue by random new character"
      ],
      "reveal_role": "none",
      "citations": [
        {
          "title": "Jami Gold ~75% hope loss",
          "url": "https://jamigold.com/2018/07/how-can-we-use-beat-sheets-with-short-stories/",
          "note": "Crisis before climax"
        },
        {
          "title": "Writers in the Storm",
          "url": "https://writersinthestormblog.com/2023/10/reward-your-readers-with-a-battle-that-earns-the-ending/",
          "note": "Earn final confrontation"
        }
      ]
    },
    {
      "id": "murder.reveal",
      "order": 6,
      "name": "Fair reveal / reassembly",
      "act_phase": "ending",
      "purpose": "Reclassify planted clues into true solution; surprise then inevitability; no new decisive facts.",
      "duration_hint_sec": [
        220,
        270
      ],
      "must": [
        "all solution facts previously shown",
        "recontextualize ≥1 earlier detail",
        "motive consistent with character",
        "simpler story after reveal"
      ],
      "avoid": [
        "twin/passage/poison debut",
        "unforeshadowed twist",
        "cheat withholding"
      ],
      "reveal_role": "twist",
      "citations": [
        {
          "title": "Fair-play contract",
          "url": "https://marychuks.com/fair-play-mystery-hide-truth-plain-sight/",
          "note": "Surprise from reinterpretation"
        },
        {
          "title": "Christie-style reveal",
          "url": "https://www.writingmanager.com/sylvia/agatha-christies-mystery-formula/",
          "note": "Proof not announcement; inevitable in hindsight"
        },
        {
          "title": "NYC Midnight twists",
          "url": "https://www.nycmidnight.com/blog/plot-twists",
          "note": "Foreshadowed load-bearing twist"
        }
      ],
      "ending_strength": "required_high"
    },
    {
      "id": "murder.coda",
      "order": 7,
      "name": "Consequence + resonant echo",
      "act_phase": "ending",
      "purpose": "Arrest/escape-cost/moral chill; echo opening image; hard punch stop — not explanation sprawl.",
      "duration_hint_sec": [
        270,
        300
      ],
      "must": [
        "status change for living characters",
        "opening token returns transformed",
        "cut after peak meaning"
      ],
      "avoid": [
        "fade unsolved",
        "lecture denouement",
        "soft 'maybe never know'"
      ],
      "reveal_role": "payoff",
      "ending_strength": "required_high",
      "citations": [
        {
          "title": "Kidder endings",
          "url": "https://hannahleekidder.com/2023/07/05/how-to-end-a-short-story-strategies-examples/",
          "note": "Last image sticks"
        },
        {
          "title": "River short endings",
          "url": "https://rivereditor.com/guides/how-to-structure-short-stories-2026",
          "note": "Inevitable in retrospect; end earlier on punch"
        },
        {
          "title": "STC micro finale twist",
          "url": "https://savethecat.com/beat-sheets/save-the-kitten-stc-and-micro-shorts",
          "note": "Finale recontextualizes opening"
        }
      ]
    }
  ],
  "timeline_patterns": [
    "linear_discovery",
    "aftermath_then_flashback",
    "in_medias_res_kill_then_reconstruct"
  ],
  "character_depth_rules": [
    "Victim + killer + ≤2 others",
    "Detective/witness has one bias that misreads a clue",
    "Motive fits established yearning",
    "Fair clues ≥2 with dual readings before reveal"
  ],
  "opening_hook_patterns": [
    "aftermath_intent",
    "body_discovery_mid_action",
    "hitchcock_bomb_suspense",
    "killer_calm_routine_with_tell"
  ],
  "ending_patterns": [
    "clue_parade_reassembly",
    "tell_exposed",
    "false_prior_punctured",
    "suspense_release",
    "moral_chill_coda"
  ]
}
{
  "id": "beats-crime-of-passion-v1",
  "genre": "crime-of-passion",
  "version": "1",
  "spoken_minutes_target": {
    "min": 2,
    "max": 5
  },
  "word_count_guide": {
    "min": 400,
    "max": 750,
    "ideal": 650
  },
  "ending_strength_required": "high",
  "ending_fail_modes": [
    "fade_before_choice",
    "act_off_page",
    "glorified_no_cost",
    "puzzle_flip_without_heat",
    "smirk_getaway"
  ],
  "beats": [
    {
      "id": "passion.hook",
      "order": 1,
      "name": "Wound cold open",
      "act_phase": "beginning",
      "purpose": "Drop into jealousy/betrayal/humiliation evidence; plant token that ending will ruin or weaponize.",
      "duration_hint_sec": [
        0,
        25
      ],
      "must": [
        "emotional wound visible",
        "relationship context implied",
        "token plant"
      ],
      "avoid": [
        "marriage Wikipedia",
        "cool detective distance as default POV"
      ],
      "reveal_role": "plant",
      "citations": [
        {
          "title": "Handley cold open",
          "url": "https://annhandley.com/cold-open-2/",
          "note": "Specific moment"
        },
        {
          "title": "CrimeReads revenge",
          "url": "https://crimereads.com/revenge-in-fiction-author-discussion/",
          "note": "Grief obsession rage"
        }
      ]
    },
    {
      "id": "passion.bond",
      "order": 2,
      "name": "Bond & identity threat",
      "act_phase": "beginning",
      "purpose": "Show what was loved and what pride/self cannot bear losing; make passion intelligible.",
      "duration_hint_sec": [
        20,
        55
      ],
      "must": [
        "felt attachment",
        "identity threat named in behavior",
        "pressure cooker hint"
      ],
      "avoid": [
        "unmotivated rage",
        "glamor setup without human texture"
      ],
      "reveal_role": "plant",
      "citations": [
        {
          "title": "CrimeReads character-driven revenge",
          "url": "https://crimereads.com/revenge-in-fiction-author-discussion/",
          "note": "Visceral thirst via character"
        },
        {
          "title": "McKee want/need",
          "url": "https://literarysofa.com/2014/02/06/a-novel-view-of-robert-mckees-story-substance-structure-style-and-the-principles-of-screenwriting/",
          "note": "Desire engine"
        }
      ]
    },
    {
      "id": "passion.escalate",
      "order": 3,
      "name": "Obsession escalates / exits close",
      "act_phase": "middle",
      "purpose": "Remove dignified exits; evidence or jealousy narrows options; heat rises.",
      "duration_hint_sec": [
        55,
        130
      ],
      "must": [
        "options narrow",
        "POV claustrophobia",
        "relationship texture continues"
      ],
      "avoid": [
        "procedural detours",
        "new subplot",
        "wide geographic hop"
      ],
      "reveal_role": "plant",
      "citations": [
        {
          "title": "Thriller narrowing choices",
          "url": "https://writeaibook.com/tools/thriller-outline-template",
          "note": "Remove safe options"
        },
        {
          "title": "Hitchcock bomb",
          "url": "https://www.davidbordwell.net/blog/2013/11/29/hitchcock-lessing-and-the-bomb-under-the-table/",
          "note": "Audience anticipation"
        }
      ]
    },
    {
      "id": "passion.midpoint",
      "order": 4,
      "name": "Confirmation or refused mercy",
      "act_phase": "middle",
      "purpose": "Betrayal confirmed (or chance at mercy refused); path to irreversible act becomes likely.",
      "duration_hint_sec": [
        130,
        180
      ],
      "must": [
        "confirmation or mercy window",
        "protagonist chooses heat over exit",
        "listener feels inevitability building"
      ],
      "avoid": [
        "midpoint cool banter reset",
        "random violence without confirm"
      ],
      "reveal_role": "plant",
      "citations": [
        {
          "title": "Yorke midpoint",
          "url": "https://www.johnyorkestory.com/five-act-structure/",
          "note": "Revelation/irreversible"
        },
        {
          "title": "Shortzly open loop",
          "url": "https://shortzly.com/blog/short-form-video-storytelling-structures",
          "note": "Hold tension to late payoff"
        }
      ]
    },
    {
      "id": "passion.trap",
      "order": 5,
      "name": "Trap / point-of-no-return approach",
      "act_phase": "middle",
      "purpose": "Location/time traps parties together; body language precedes decision; last exit flashes.",
      "duration_hint_sec": [
        180,
        230
      ],
      "must": [
        "shared confined arena",
        "last exit visible then closed",
        "act imminent"
      ],
      "avoid": [
        "fade before choice",
        "cavalry interrupt without cost"
      ],
      "reveal_role": "none",
      "citations": [
        {
          "title": "Writers in the Storm crisis",
          "url": "https://writersinthestormblog.com/2023/10/reward-your-readers-with-a-battle-that-earns-the-ending/",
          "note": "Crisis before climax"
        },
        {
          "title": "Stevens aftermath model",
          "url": "http://www.bkstevensmysteries.com/book/the-last-blue-glass/",
          "note": "Dinner party revenge pressure"
        }
      ]
    },
    {
      "id": "passion.act",
      "order": 6,
      "name": "Irreversible act (on-page)",
      "act_phase": "ending",
      "purpose": "The passion crime or moral rupture happens in scene — not reported later.",
      "duration_hint_sec": [
        230,
        270
      ],
      "must": [
        "on-page irreversible moment",
        "clear causality from wound",
        "sensory specificity without gore-porn"
      ],
      "avoid": [
        "off-page act",
        "cartoon violence",
        "act without prior pressure"
      ],
      "reveal_role": "payoff",
      "citations": [
        {
          "title": "CrimeReads cost of revenge",
          "url": "https://crimereads.com/revenge-in-fiction-author-discussion/",
          "note": "Consequences required"
        },
        {
          "title": "Poe single effect",
          "url": "https://www.eapoe.org/works/criticsm/gm442hn1.htm",
          "note": "Design toward final effect"
        }
      ],
      "ending_strength": "required_high"
    },
    {
      "id": "passion.aftermath",
      "order": 7,
      "name": "Aftermath cost + token echo",
      "act_phase": "ending",
      "purpose": "Pyrrhic/tragic/moral weight; loss still lost; opening token returns transformed; hard resonant stop.",
      "duration_hint_sec": [
        270,
        300
      ],
      "must": [
        "emotional or moral cost on-page",
        "echo opening token",
        "no glorified shrug",
        "decisive last image"
      ],
      "avoid": [
        "smirk getaway",
        "fade before meaning",
        "PSA lecture",
        "unsolved shrug"
      ],
      "reveal_role": "payoff",
      "ending_strength": "required_high",
      "citations": [
        {
          "title": "CrimeReads aftermath",
          "url": "https://crimereads.com/revenge-in-fiction-author-discussion/",
          "note": "Loss remains after revenge"
        },
        {
          "title": "Kidder endings",
          "url": "https://hannahleekidder.com/2023/07/05/how-to-end-a-short-story-strategies-examples/",
          "note": "Echo beginning"
        },
        {
          "title": "Writers.com change/meaning",
          "url": "https://writers.com/feature/better-endings-surprising-yet-inevitable-and-astonishing",
          "note": "Meaning from change"
        }
      ]
    }
  ],
  "timeline_patterns": [
    "continuous_eruption_night",
    "aftermath_then_flashback",
    "in_medias_res_aftermath_then_reconstruct"
  ],
  "character_depth_rules": [
    "Dyad or triangle only",
    "Bond must be felt on-page before rupture",
    "One identity threat drives the passion",
    "Sympathy without endorsement; consequence is craft"
  ],
  "opening_hook_patterns": [
    "evidence_of_betrayal",
    "public_humiliation",
    "reunion_that_reopens_wound",
    "weaponized_hospitality_ticking"
  ],
  "ending_patterns": [
    "pyrrhic_completion",
    "tragic_error_wrong_target",
    "mercy_refused_too_late",
    "grotesque_ordinary_after",
    "confession_to_the_dead",
    "justice_as_humiliation_or_relief"
  ]
}